# ==========================================
# FairRide AI - Git Ignore Rules
# ==========================================

# Virtual Environments (Python)
venv/
backend/venv/
.venv/
env/
ENV/

# User Uploads & Media (Ignore user uploaded files, preserve directory via .gitkeep)
uploads/
uploads/*
!uploads/.gitkeep
backend/uploads/
backend/uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Environment Files & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.local
frontend/.env.*
!frontend/.env.example

# Python Caches & Compiled Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Frontend / Next.js Build Outputs
.next/
frontend/.next/
out/
build/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# Typescript
*.tsbuildinfo

docs
schema.md